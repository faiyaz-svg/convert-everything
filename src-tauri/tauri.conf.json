{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convert Everything",
  "mainBinaryName": "convert-everything",
  "version": "0.1.1",
  "identifier": "com.faiyaz.converteverything",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Convert Everything",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Faiyaz Saraf",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Convert files between formats on your own computer",
    "longDescription": "Convert Everything converts images, audio, video, documents, ebooks, archives, data files and fonts. Every conversion runs on your computer. Nothing is uploaded.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
